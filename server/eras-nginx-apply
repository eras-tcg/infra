#!/usr/bin/env bash
# Install an nginx vhost for ERAS and reload nginx; restores the previous file if nginx -t fails.
# Installed as root:root 0755 in /usr/local/sbin; github-runner may run ONLY this via sudoers.
# Usage: eras-nginx-apply <source-file> <erastcg.com|staging.erastcg.com|next.erastcg.com>
set -euo pipefail

src="${1:?source file}"; name="${2:?vhost name}"
case "$name" in
  erastcg.com|staging.erastcg.com|next.erastcg.com) ;;
  *) echo "vhost not allowed: $name" >&2; exit 2 ;;
esac
[ -f "$src" ] || { echo "missing $src" >&2; exit 2; }

dest="/etc/nginx/sites-enabled/$name"
backup=$(mktemp)
[ -f "$dest" ] && cp -p "$dest" "$backup"

install -m 0644 -o root -g root "$src" "$dest"
if nginx -t 2>&1; then
  systemctl reload nginx
  echo "nginx vhost $name applied"
else
  echo "nginx -t failed, restoring previous $name" >&2
  [ -s "$backup" ] && install -m 0644 -o root -g root "$backup" "$dest"
  rm -f "$backup"
  exit 1
fi
rm -f "$backup"
